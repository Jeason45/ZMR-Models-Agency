// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin") // "admin" or "user"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================
// AGENCY SETTINGS (Configuration de l'agence)
// ============================================

model AgencySettings {
  id        String   @id @default(cuid())

  // Informations de base
  nom_agence        String
  adresse_agence    String
  telephone_agence  String
  email_agence      String
  site_web_agence   String?

  // Informations juridiques
  siret_agence      String
  forme_juridique   String   // SARL, SAS, EURL, etc.
  capital           String   // "10 000 EUR"
  ville_rcs         String   // Ville d'immatriculation RCS
  numero_rcs        String   // Numéro RCS

  // Représentant légal
  representant_nom      String
  representant_qualite  String  // Président, Gérant, Directeur, etc.

  // Médias
  logo_path         String?
  signature_path    String?

  // Paramètres par défaut pour documents
  tva_par_defaut    Float    @default(20.0)  // TVA en %
  delai_paiement_defaut String @default("30 jours")
  validite_devis_defaut Int    @default(30)  // En jours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agency_settings")
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  message      String?       @db.Text
  type         String?       // "professional", "model"
  status       String        @default("new") // "new", "contacted", "qualified", "client", "lost"
  source       String?       // "website", "referral", etc.
  notes        String?       @db.Text // Notes internes sur le lead

  // Type de contact (pour distinguer particulier/entreprise)
  contactType  String?       // "particulier", "entreprise", "agence"

  // Informations complètes client (pour DEVIS/FACTURES)
  adresse_client    String?
  ville             String?
  code_postal       String?
  site_web_client   String?

  // Informations juridiques (pour entreprises)
  siret             String?
  forme_juridique   String?  // SARL, SAS, etc.

  // Destinataire (personne de contact si différente du client)
  nom_destinataire       String?
  adresse_destinataire   String?
  telephone_destinataire String?
  email_destinataire     String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  appointments       Appointment[]
  documents          Document[]
  mailLogs           MailLog[]

  @@map("contacts")
}

model Appointment {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      String   @default("scheduled") // "scheduled", "confirmed", "cancelled", "completed"
  location    String?  // "video", "phone", "office"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("appointments")
}

model Availability {
  id        String   @id @default(cuid())
  dayOfWeek Int // 0 = Sunday, 1 = Monday, etc.
  startTime String // "09:00"
  endTime   String // "17:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("availability")
}

// ============================================
// TALENTS (Models, Acting, Promo, Details)
// ============================================

model Talent {
  id        String   @id @default(cuid())

  // Type de talent
  type      String   // "MODELS", "ACTING", "PROMO", "DETAILS"

  // Infos de base
  name      String
  slug      String   @unique
  category  String   // Pour MODELS: "woman"/"man", ACTING: "commercial"/"cinema"/"theater", PROMO: array, DETAILS: "hands"/"face"/etc.
  status    String   @default("active") // "active", "inactive", "archived"

  // Images principales (tous types)
  mainImage      String?  // Chemin vers l'image principale
  hoverImage     String?  // Chemin vers l'image au survol
  heroVideo      String?  // Chemin vers la vidéo hero
  heroImage      String?  // Pour DETAILS uniquement

  // Gallery Images (array stocké en JSON)
  galleryImages  Json?    // Array de chemins d'images

  // Portfolio Section (MODELS & DETAILS)
  portfolioImage   String?
  portfolioGallery Json?   // Array de chemins d'images

  // Instagram Section (tous types)
  instagramImage String?
  instagramUrl   String?

  // Shows Section (MODELS uniquement)
  showsImage String?
  showsVideo String?

  // Showreel Section (ACTING uniquement)
  showreelVideo String?
  showreelImage String?
  reelsGallery  Json?    // Array de chemins de vidéos

  // Credits (ACTING uniquement) - Array d'objets {title, role, year, type}
  credits       Json?
  creditsImage  String?

  // Collaborations Section (PROMO uniquement) - Array d'objets {brandName, logo, campaignImage}
  collaborations Json?
  collaborationsImage String?

  // Events Section (PROMO uniquement)
  eventsGallery Json?   // Array de chemins d'images
  eventsImage   String? // Cover image pour la section Events

  // Social Section (PROMO uniquement)
  socialImage   String?

  // Campaigns Section (DETAILS uniquement) - Array d'objets {brandName, logo, campaignImage}
  campaigns     Json?
  campaignsImage String?

  // Mensurations communes
  height  String?
  eyes    String?
  hair    String?

  // Mensurations MODELS
  neck    String?
  bust    String?
  chest   String?
  waist   String?
  hips    String?
  suit    String?
  inseam  String?
  shoes   String?

  // Mensurations DETAILS
  handSize    String?
  ringSize    String?
  wristSize   String?
  footSize    String?
  legLength   String?
  neckSize    String?
  skinTone    String?
  faceSpecialty Json?  // Array: ["lips", "eyes", "teeth", "skin"]

  // Champs spécifiques ACTING
  ageRange    String?  // Ex: "25-35"
  languages   Json?    // Array de langues
  skills      Json?    // Array de compétences

  // Champs spécifiques PROMO
  instagramFollowers Int?
  tiktokFollowers    Int?
  tiktokUrl          String?
  promoCategories    Json?  // Array: ["Beauty & Fashion", "Luxury Events", "Lifestyle"]

  // Informations personnelles complètes (pour CONTRATS)
  prenom_talent      String?
  nom_talent         String?
  date_naissance     DateTime?
  lieu_naissance     String?
  nationalite        String?
  adresse_talent     String?
  numero_ss_talent   String?  // Numéro sécurité sociale
  telephone_talent   String?
  email_talent       String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents Document[]

  @@index([type])
  @@index([slug])
  @@map("talents")
}

// ============================================
// DOCUMENTS SYSTEM
// ============================================

// Templates de documents (les 22 fichiers DOCX)
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String   // "Contrat Mannequinat Mode", "Devis Moderne"
  slug        String   @unique // "contrat-mannequinat-mode", "devis-moderne"
  type        String   // "CONTRAT", "FACTURE", "DEVIS", "ADMINISTRATIF"
  category    String   // "talent", "client", "commercial", "admin"
  description String?

  // Format du template (NOUVEAU)
  format      String   @default("docx") // "docx" (ancien système) ou "html" (nouveau système Puppeteer)

  // Fichier template DOCX (ancien système)
  fileName    String?  // "Contrat_Mannequinat_Mode.docx"
  filePath    String?  // Chemin vers le template DOCX

  // Template HTML (nouveau système)
  htmlContent String?  @db.Text // HTML complet pour génération Puppeteer

  // Variables dynamiques dans le template (JSON array)
  // Ex: ["nom_talent", "date_debut", "tarif_journalier"]
  variables   Json?

  // Mapping des champs dynamiques (configuration de l'auto-remplissage)
  // Ex: {"nom_client": {"source": "contact", "field": "name", "autoFill": true}}
  fieldMapping Json?

  // Champs éditables par le client (pour édition PDF)
  // Ex: [{name: "nom_complet", label: "Nom complet", type: "text", required: true, defaultValue: ""}]
  editableFields Json?

  // Configuration
  requiresSignature Boolean @default(false)
  isActive          Boolean @default(true)
  isDefault         Boolean @default(false) // Template par défaut pour ce type

  // Aperçu (optionnel)
  thumbnailUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents Document[]

  @@index([format])
  @@index([type])
  @@index([isDefault])
  @@map("document_templates")
}

// Documents générés à partir des templates
model Document {
  id              String   @id @default(cuid())

  // Lien vers le template utilisé
  templateId      String?
  template        DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Type et catégorie
  type            String   // "CONTRAT_MODELE", "FACTURE", "DEVIS", etc.
  category        String   // "contrat", "commercial", "administratif", "talent"

  // Fichiers générés
  fileName        String   // "Contrat_Camille_Dupont_2025-11-02.pdf"
  filePath        String   // Chemin relatif dans storage/documents/
  originalDocx    String?  // Chemin vers le DOCX rempli (avant conversion PDF)
  signedPdfPath   String?  // Chemin vers le PDF signé avec signature intégrée

  // Données du document (JSON contenant toutes les valeurs)
  // Ex: {"nom_talent": "Camille Dupont", "date_debut": "2025-12-01", ...}
  data            Json?

  // Données remplies par le client (édition PDF)
  // Ex: {"nom_complet": "Jean Dupont", "adresse": "123 rue...", ...}
  formData        Json?

  // Workflow
  status          String   @default("draft") // "draft", "sent", "pending_edit", "edited", "pending_signature", "signed", "archived", "cancelled"

  // Numérotation automatique (ex: FACT-2025-001, CONT-2025-042)
  documentNumber  String?  @unique

  // Relations possibles (un document peut être lié à différents types)
  talentId        String?
  talent          Talent?  @relation(fields: [talentId], references: [id], onDelete: Cascade)

  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Montants (pour factures/devis)
  amountHT        Float?   // Montant HT
  amountTTC       Float?   // Montant TTC
  currency        String   @default("EUR")

  // Dates importantes
  issueDate       DateTime? // Date d'émission
  dueDate         DateTime? // Date d'échéance (factures)
  expiresAt       DateTime? // Date d'expiration (contrats)

  // Signature
  signedAt        DateTime?
  signedBy        String?  // Nom du signataire
  signatureImage  String?  // Chemin vers l'image de signature

  // Métadonnées
  generatedBy     String?  // Admin qui a généré
  sentAt          DateTime? // Date d'envoi par mail
  notes           String?
  tags            Json?    // Array de tags pour filtrage

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  signatures         Signature[]
  signatureRequests  SignatureRequest[]
  mailLogs           MailLog[]

  @@index([status])
  @@index([type])
  @@index([talentId])
  @@index([contactId])
  @@map("documents")
}

// Signatures électroniques avec preuves légales
model Signature {
  id            String   @id @default(cuid())

  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Informations signataire
  signerName    String
  signerEmail   String
  signerRole    String?  // "talent", "client", "agent", "parent"

  // Signature
  signatureImage String  // Chemin vers l'image de la signature (canvas PNG)
  signatureType  String  @default("electronic") // "electronic", "drawn", "typed"

  // Preuves légales (horodatage certifié)
  signedAt      DateTime @default(now())
  ipAddress     String
  userAgent     String?
  location      String?  // Géolocalisation optionnelle

  // Hash cryptographique du PDF signé (SHA-256)
  documentHash  String   // Hash du PDF pour vérification d'intégrité

  // Preuve JSON complète (stockée comme backup)
  proofData     Json?    // Contient: {hash, ip, timestamp, signature, metadata}

  // Validation
  isValid       Boolean  @default(true)
  validatedAt   DateTime?
  validatedBy   String?

  createdAt     DateTime @default(now())

  // Relation inverse avec SignatureRequest (optionnelle)
  signatureRequest SignatureRequest?

  @@index([documentId])
  @@index([signerEmail])
  @@map("signatures")
}

// Demandes de signature avec tokens sécurisés
model SignatureRequest {
  id            String   @id @default(cuid())

  // Document à signer
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Token unique pour le lien de signature
  token         String   @unique // Token sécurisé (crypto.randomBytes)

  // Informations du destinataire
  recipientEmail String
  recipientName  String?

  // Expiration du lien (généralement 30 jours)
  expiresAt     DateTime

  // Statut
  status        String   @default("pending") // "pending", "completed", "expired", "cancelled"

  // Une fois signée, référence vers la signature
  signatureId   String?  @unique
  signature     Signature? @relation(fields: [signatureId], references: [id], onDelete: SetNull)

  // Tracking
  sentAt        DateTime @default(now())
  viewedAt      DateTime? // Première fois que le lien est ouvert
  completedAt   DateTime? // Quand la signature est effectuée

  // Métadonnées
  reminders     Int      @default(0) // Nombre de relances envoyées
  lastReminderAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([token])
  @@index([documentId])
  @@index([recipientEmail])
  @@index([status])
  @@map("signature_requests")
}

// Logs de tous les mails envoyés
model MailLog {
  id          String   @id @default(cuid())

  // Type de mail
  type        String   // "document_sent", "signature_request", "confirmation", "reminder"
  subject     String

  // Destinataire
  to          String
  cc          String?
  bcc         String?

  // Contenu
  htmlContent String?  @db.Text
  textContent String?  @db.Text

  // Pièces jointes
  attachments Json?    // Array: [{filename: "contract.pdf", path: "/storage/..."}]

  // Relations optionnelles
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  talentId    String?

  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Tracking
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?

  // Statut
  status      String    @default("sent") // "sent", "delivered", "opened", "clicked", "bounced", "failed"
  error       String?   // Message d'erreur si échec

  // Métadonnées
  sentBy      String?   // Admin qui a déclenché l'envoi

  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([to])
  @@index([documentId])
  @@index([sentAt])
  @@map("mail_logs")
}

// ============================================
// BLOG
// ============================================

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique

  // Contenu
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text

  // Media
  coverImage  String

  // Catégorie
  category    String   // "Actualités", "Success Stories", "Conseils", "Behind-the-Scenes", "Industrie"

  // Tags (optionnel)
  tags        Json?    // Array de tags: ["Fashion Week", "Elite", "Shooting"]

  // Auteur
  author      String   @default("ZMR Models Agency")

  // SEO
  metaTitle       String?
  metaDescription String?

  // Publication
  published   Boolean  @default(false)
  publishedAt DateTime?

  // Stats
  readTime    Int?     // Temps de lecture estimé en minutes
  views       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([published])
  @@index([publishedAt])
  @@map("blog_posts")
}

