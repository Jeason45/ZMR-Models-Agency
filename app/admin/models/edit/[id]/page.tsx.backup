            border: '1px solid #e2e8f0',
            borderRadius: '6px',
            fontSize: '14px',
          }}
        />
        {/* Afficher les images existantes */}
        {existingImages.galleryImages && Array.isArray(existingImages.galleryImages) && existingImages.galleryImages.length > 0 && (
          <div style={{ marginTop: '12px' }}>
            <p style={{ fontSize: '13px', color: '#64748b', marginBottom: '8px' }}>Images existantes:</p>
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(100px, 1fr))', gap: '8px' }}>
              {existingImages.galleryImages.map((url: string, index: number) => (
                <div key={`existing-${index}`} style={{ position: 'relative' }}>
                  <img
                    src={url}
                    alt={`Gallery ${index}`}
                    style={{ width: '100%', height: '100px', objectFit: 'cover', borderRadius: '6px' }}
                  />
                </div>
              ))}
            </div>
          </div>
        )}
        {/* Afficher les nouvelles images */}
        {formData.galleryImages.length > 0 && (
          <div style={{ marginTop: '12px' }}>
            <p style={{ fontSize: '13px', color: '#64748b', marginBottom: '8px' }}>Nouvelles images:</p>
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(100px, 1fr))', gap: '8px' }}>
              {formData.galleryImages.map((_, index) => (
